# Copia questo file in ".env" e inserisci ALMENO una delle due chiavi.
# I valori nel file .env hanno la precedenza sulle variabili di sistema.

# Claude (Anthropic) - https://platform.claude.com
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-opus-5-5
# Livello di ragionamento per generare la SQL: low | medium | high
CLAUDE_EFFORT_SQL=medium

# OpenAI - https://platform.openai.com
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini

# Provider selezionato all'apertura: claude | openai | demo
LLM_PROVIDER=claude

# Porta del server API (Vite gira sulla 5173 e inoltra /api qui)
API_PORT=3001
