{
  "name": "falconeye",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Demo: ERP fittizio -> tabelle di staging di produzione -> dashboard React con domande in linguaggio naturale (Claude / OpenAI)",
  "scripts": {
    "db:erp": "node server/db/createErp.js",
    "db:etl": "node server/db/etl.js",
    "db:reset": "node server/db/createErp.js && node server/db/etl.js",
    "server": "node server/index.js",
    "client": "vite",
    "dev": "concurrently -n api,web -c blue,green \"npm:server\" \"npm:client\"",
    "build": "vite build"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.10.0",
    "better-sqlite3": "^13.2.0",
    "express": "^5.3.0",
    "openai": "^7.60.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^6.3.0",
    "concurrently": "^10.0.7",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "recharts": "^3.11.0",
    "vite": "^8.3.8"
  }
}
